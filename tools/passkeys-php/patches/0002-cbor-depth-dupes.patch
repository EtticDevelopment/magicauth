+    protected static function _parseItem(ByteBuffer $buf, &$offset, $depth = 0) {
+        if ($depth > self::MAX_DEPTH) {
+            throw new WebAuthnException('Maximum nesting depth exceeded.', WebAuthnException::CBOR);
+        }
+
         $first = $buf->getByteVal($offset++);
         $type = $first >> 5;
         $val = $first & 0b11111;
@@ -73,7 +81,7 @@
 
