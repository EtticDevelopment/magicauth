@@ -162,7 +170,7 @@
         return $val;
     }
 
-    protected static function _parseItemData($type, $val, ByteBuffer $buf, &$offset) {
+    protected static function _parseItemData($type, $val, ByteBuffer $buf, &$offset, $depth = 0) {
