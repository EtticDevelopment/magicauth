msgid "Link &amp; code lifetime"
msgstr "Duración del enlace &amp; código"

#: includes/Admin/Settings.php:718
msgid "Both the magic link and the typeable code share one expiry. Range 1–30 minutes."
msgstr "El enlace mágico y el código tecleable comparten un mismo vencimiento. Rango de 1–30 minutos."

#: includes/Admin/Settings.php:722
msgid "minutes"
msgstr "minutos"

#: includes/Admin/Settings.php:734 includes/Admin/Settings.php:738
msgid "Max link uses"
msgstr "Usos máximos del enlace"

#: includes/Admin/Settings.php:735
msgid "2 absorbs URL-scanner prefetch plus the user's click. Set to 1 for strict single-use."
msgstr "2 absorbe la precarga de los escáneres de URL más el clic del usuario. Establezca 1 para un uso único estricto."

